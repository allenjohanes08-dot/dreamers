rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/products/{productId}/videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /products/{productId}/videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Legacy path, keep for now but we'll move away from it
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /shops/{shopId}/logo/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
